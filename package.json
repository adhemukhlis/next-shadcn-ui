	],
	"dependencies": {
		"@base-ui/react": "^1.7.0",
		"@tailwindcss/postcss": "^4.3.3",
		"class-variance-authority": "^0.7.1",
		"clsx": "^2.1.1",
		"lucide-react": "^1.31.0",
		"next": "^16.3.0",
		"react": "^19.2.8",
		"react-dom": "^19.2.8",
		"shadcn": "^4.17.0",
		"tailwind-merge": "^3.6.0",
		"tailwindcss": "^4.3.3",
		"tw-animate-css": "^1.4.0"
	},
	"devDependencies": {
		"@types/node": "^26.2.0",
