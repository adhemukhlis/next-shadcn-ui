	"name": "next-shadcn-ui",
	"private": true,
	"scripts": {
		"build": "next build",
		"deps:reset": "rm -rf node_modules .next && pnpm install",
		"deps:show": "pnpm ls --depth=Infinity",
		"deps:upgrade": "pnpm dlx npm-check-updates -u && pnpm install",
		"dev": "node --env-file=.env server.js dev",
		"fix": "node ./dev/lint.js --config ./dev/eslint.config.mjs --fix .",
		"format": "pnpm run --prefix dev format",
		"lint": "node ./dev/lint.js --config ./dev/eslint.config.mjs .",
		"minify": "pnpm run --prefix dev minify",
		"size": "du -k -d 1 . | sort -nr > size.txt",
		"start": "node --env-file=.env server.js start",
		"typecheck": "tsc --noEmit",
		"unused": "pnpm dlx knip --no-exit-code 2>&1 | tail -n +2 > knip-report.txt"
	},
	"packageManager": "pnpm@11.21.0+sha512.521705bce689924eac72f5a3587122f362689ef6571e55ba80076fd637c11132ecffada26fad4ea79c485bfddbfd3d5a2a5b05805a77e893de71ec8a6cca3bb1",
	"version": "0.1.0"
}
